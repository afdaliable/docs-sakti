---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { muatKonfigurasi } from '~/lib/modul.ts';
import { JENIS_LABEL } from '~/lib/istilah.ts';

const konfigurasi = muatKonfigurasi();
const base = import.meta.env.BASE_URL;
const jenisDaftar = Object.entries(JENIS_LABEL).filter(([k]) => k !== 'indeks');
---

<StarlightPage
	frontmatter={{ title: 'Hasil pencarian', template: 'splash', pagefind: false }}
>
	<div class="halaman-cari" data-base={base}>
		<form id="form-cari" role="search" method="get">
			<label class="sr-only" for="input-q">Cari panduan SAKTI</label>
			<div class="baris-cari">
				<input
					id="input-q"
					type="search"
					name="q"
					autocomplete="off"
					placeholder='Cari panduan SAKTI, mis. "cara batal SPM"'
				/>
				<button type="submit">Cari</button>
			</div>
			<div class="kontrol-filter">
				<details class="filter-modul" id="filter-modul">
					<summary>Modul</summary>
					<fieldset>
						<legend class="sr-only">Filter modul</legend>
						{
							konfigurasi.modul.map((m) => (
								<label class="cek-modul">
									<input type="checkbox" name="modul" value={m.slug} />
									{m.nama}
								</label>
							))
						}
					</fieldset>
				</details>
				<label class="filter-select">
					Peran
					<select name="peran">
						<option value="">Semua peran</option>
						{konfigurasi.peran.map((p) => <option value={p.slug}>{p.nama}</option>)}
					</select>
				</label>
				<label class="filter-select">
					Jenis
					<select name="jenis">
						<option value="">Semua jenis</option>
						{jenisDaftar.map(([slug, nama]) => <option value={slug}>{nama}</option>)}
					</select>
				</label>
			</div>
		</form>

		<p id="jumlah-hasil" class="jumlah-hasil" aria-live="polite"></p>
		<ul id="daftar-hasil" class="daftar-hasil"></ul>
		<nav id="nav-halaman" class="nav-halaman" aria-label="Halaman hasil" hidden>
			<button type="button" data-hal="sebelumnya">Sebelumnya</button>
			<span id="info-halaman"></span>
			<button type="button" data-hal="berikutnya">Berikutnya</button>
		</nav>

		<div id="tanpa-hasil" class="tanpa-hasil" hidden>
			<p id="pesan-tanpa-hasil"></p>
			<ul id="saran-istilah" class="saran-istilah"></ul>
			<p>
				<a href={`${base}#modul`}>Lihat semua modul</a>
				{' · '}
				<a id="usulkan-artikel" href="#">Usulkan artikel</a>
			</p>
		</div>
		<p id="pesan-galat" class="pesan-galat" hidden>
			Pencarian tidak dapat dijalankan. Muat ulang halaman atau coba lagi nanti.
		</p>
		<noscript>
			<p>
				Pencarian memerlukan JavaScript. Aktifkan JavaScript atau jelajahi
				<a href={`${base}#modul`}>daftar modul</a>.
			</p>
		</noscript>
	</div>
</StarlightPage>

<script>
	import { navigate } from 'astro:transitions/client';
	import { siapkanLevel1, muatSinonim } from '../lib/cari/klien';
	import { cariLevel1 } from '../lib/cari/level1';
	import type { ButirHasil, FilterCari, Ketergantungan } from '../lib/cari/level1';
	import type { EntriSinonim } from '../lib/cari/kueri';
	import { tautanUsulan } from '../lib/situs';

	const PER_HALAMAN = 20;

	let dep: Ketergantungan | null = null;
	let token = 0;

	function pasang(root: HTMLElement) {
		const base = root.dataset.base ?? '/';
		let sinonim: EntriSinonim[] = [];

		const form = document.getElementById('form-cari') as HTMLFormElement;
		const inputQ = document.getElementById('input-q') as HTMLInputElement;
		const daftarHasil = document.getElementById('daftar-hasil')!;
		const jumlahHasil = document.getElementById('jumlah-hasil')!;
		const navHalaman = document.getElementById('nav-halaman')!;
		const infoHalaman = document.getElementById('info-halaman')!;
		const tanpaHasil = document.getElementById('tanpa-hasil')!;
		const pesanTanpaHasil = document.getElementById('pesan-tanpa-hasil')!;
		const saranIstilah = document.getElementById('saran-istilah')!;
		const usulkan = document.getElementById('usulkan-artikel') as HTMLAnchorElement;
		const pesanGalat = document.getElementById('pesan-galat')!;

		let hasil: ButirHasil[] = [];
		let jumlahPagefind = 0;

		function bacaUrl() {
			const p = new URLSearchParams(location.search);
			return {
				q: p.get('q') ?? '',
				modul: p.getAll('modul'),
				peran: p.get('peran') ?? '',
				jenis: p.get('jenis') ?? '',
				hal: Math.max(1, parseInt(p.get('hal') ?? '1', 10) || 1),
			};
		}

		function terapkanKeForm() {
			const s = bacaUrl();
			inputQ.value = s.q;
			for (const c of form.querySelectorAll<HTMLInputElement>('input[name="modul"]')) {
				c.checked = s.modul.includes(c.value);
			}
			(form.elements.namedItem('peran') as HTMLSelectElement).value = s.peran;
			(form.elements.namedItem('jenis') as HTMLSelectElement).value = s.jenis;
		}

		function filterDariForm(): FilterCari {
			const modul = [...form.querySelectorAll<HTMLInputElement>('input[name="modul"]:checked')].map(
				(c) => c.value,
			);
			const filter: FilterCari = {};
			if (modul.length > 0) filter.modul = modul;
			const peran = (form.elements.namedItem('peran') as HTMLSelectElement).value;
			const jenis = (form.elements.namedItem('jenis') as HTMLSelectElement).value;
			if (peran) filter.peran = peran;
			if (jenis) filter.jenis = jenis;
			return filter;
		}

		function saranDariSinonim(q: string): string[] {
			const token = q
				.toLowerCase()
				.split(/[^\p{L}\p{N}]+/u)
				.filter((t) => t.length >= 2);
			const cocok = new Set<string>();
			for (const entri of sinonim) {
				const istilah = [entri.istilah, ...entri.sinonim].map((s) => s.toLowerCase());
				if (
					token.some(
						(t) => istilah.some((s) => s.includes(t)) || t.includes(entri.istilah.toLowerCase()),
					)
				) {
					cocok.add(entri.istilah);
				}
				if (cocok.size >= 3) break;
			}
			return [...cocok];
		}

		function setKeadaan(keadaan: string, q: string, total = 0, persis = 0) {
			root.dataset.keadaan = keadaan;
			root.dataset.kueri = q;
			if (keadaan === 'selesai') {
				root.dataset.jumlah = String(total);
				root.dataset.jumlahPagefind = String(persis);
			} else {
				delete root.dataset.jumlah;
				delete root.dataset.jumlahPagefind;
			}
		}

		async function tampilkanHalaman(hal: number, tiket: number, q: string) {
			const total = hasil.length;
			const mulai = (hal - 1) * PER_HALAMAN;
			const potongan = hasil.slice(mulai, mulai + PER_HALAMAN);
			let data;
			try {
				data = await Promise.all(potongan.map((b) => b.data()));
			} catch {
				if (tiket !== token) return;
				jumlahHasil.textContent = '';
				pesanGalat.hidden = false;
				setKeadaan('galat', q);
				return;
			}
			if (tiket !== token) return;
			daftarHasil.replaceChildren(
				...data.map((r) => {
					const li = document.createElement('li');
					const a = document.createElement('a');
					a.href = r.url;
					a.className = 'judul';
					a.textContent = r.judul;
					const meta = document.createElement('span');
					meta.className = 'meta-hasil';
					meta.textContent = [r.breadcrumb, r.jenis].filter(Boolean).join(' · ');
					li.append(a, meta);
					if (r.cuplikan) {
						const cuplikan = document.createElement('p');
						cuplikan.className = 'cuplikan';
						cuplikan.innerHTML = r.cuplikan;
						li.append(cuplikan);
					}
					return li;
				}),
			);
			const halaman = Math.max(1, Math.ceil(total / PER_HALAMAN));
			navHalaman.hidden = halaman <= 1;
			infoHalaman.textContent = `Halaman ${hal} dari ${halaman}`;
			navHalaman.querySelector<HTMLButtonElement>('[data-hal="sebelumnya"]')!.disabled = hal <= 1;
			navHalaman.querySelector<HTMLButtonElement>('[data-hal="berikutnya"]')!.disabled =
				hal >= halaman;
			setKeadaan('selesai', q, total, jumlahPagefind);
		}

		function tampilkanTanpaHasil(q: string) {
			pesanTanpaHasil.textContent = `Tidak ada hasil untuk "${q}". Coba kata lain atau saran istilah di bawah.`;
			saranIstilah.replaceChildren(
				...saranDariSinonim(q).map((istilah) => {
					const li = document.createElement('li');
					const a = document.createElement('a');
					a.href = `${location.pathname}?q=${encodeURIComponent(istilah)}`;
					a.textContent = istilah;
					li.append(a);
					return li;
				}),
			);
			usulkan.href = tautanUsulan(q);
			tanpaHasil.hidden = false;
		}

		async function jalankanCari() {
			const s = bacaUrl();
			const q = s.q.trim();
			jumlahHasil.textContent = '';
			daftarHasil.replaceChildren();
			navHalaman.hidden = true;
			tanpaHasil.hidden = true;
			pesanGalat.hidden = true;
			const tiket = ++token;
			if (q.length < 2) {
				jumlahHasil.textContent = 'Ketik minimal 2 karakter untuk mencari.';
				setKeadaan('selesai', q);
				return;
			}
			setKeadaan('mencari', q);
			jumlahHasil.textContent = 'Mencari…';
			try {
				dep ??= await siapkanLevel1();
				sinonim = await muatSinonim();
			} catch {
				dep = null;
			}
			if (tiket !== token) return;
			if (!dep) {
				jumlahHasil.textContent = '';
				pesanGalat.hidden = false;
				pesanGalat.textContent =
					'Pencarian tersedia setelah pnpm build. Jalankan pnpm preview.';
				setKeadaan('galat', q);
				return;
			}
			let res;
			try {
				res = await cariLevel1(q, filterDariForm(), dep);
			} catch {
				if (tiket !== token) return;
				jumlahHasil.textContent = '';
				pesanGalat.hidden = false;
				setKeadaan('galat', q);
				return;
			}
			if (tiket !== token) return;
			hasil = res.butir;
			jumlahPagefind = res.jumlahPagefind;
			if (hasil.length === 0) {
				jumlahHasil.textContent = '';
				tampilkanTanpaHasil(q);
				setKeadaan('selesai', q);
				return;
			}
			jumlahHasil.textContent =
				jumlahPagefind === 0
					? `Tidak ada hasil persis untuk "${q}". Menampilkan ${hasil.length} hasil yang mirip.`
					: hasil.length > jumlahPagefind
						? `${hasil.length} hasil untuk "${q}", termasuk hasil yang mirip.`
						: `${hasil.length} hasil untuk "${q}".`;
			await tampilkanHalaman(s.hal, tiket, q);
		}

		function sinkronkanUrl() {
			const q = inputQ.value.trim();
			const p = new URLSearchParams();
			if (q) p.set('q', q);
			for (const c of form.querySelectorAll<HTMLInputElement>('input[name="modul"]:checked'))
				p.append('modul', c.value);
			const peran = (form.elements.namedItem('peran') as HTMLSelectElement).value;
			const jenis = (form.elements.namedItem('jenis') as HTMLSelectElement).value;
			if (peran) p.set('peran', peran);
			if (jenis) p.set('jenis', jenis);
			history.replaceState(history.state, '', `${location.pathname}${p.size ? `?${p}` : ''}`);
		}

		form.addEventListener('submit', (e) => {
			e.preventDefault();
			sinkronkanUrl();
			jalankanCari();
		});
		form.addEventListener('change', (e) => {
			if ((e.target as HTMLElement).tagName === 'SELECT' || (e.target as HTMLInputElement).type === 'checkbox') {
				sinkronkanUrl();
				jalankanCari();
			}
		});
		navHalaman.addEventListener('click', (e) => {
			const tombol = (e.target as HTMLElement).closest('button[data-hal]');
			if (!tombol) return;
			const s = bacaUrl();
			const hal = s.hal + (tombol.getAttribute('data-hal') === 'berikutnya' ? 1 : -1);
			const p = new URLSearchParams(location.search);
			p.set('hal', String(hal));
			navigate(`${location.pathname}?${p}`);
		});

		terapkanKeForm();
		jalankanCari();
	}

	function pasangBilaPerlu() {
		const root = document.querySelector<HTMLElement>('.halaman-cari');
		if (!root || root.dataset.terpasang !== undefined) return;
		root.dataset.terpasang = '';
		pasang(root);
	}

	document.addEventListener('astro:page-load', pasangBilaPerlu);
	pasangBilaPerlu();
</script>

<style>
	.halaman-cari {
		max-width: 48rem;
	}
	.baris-cari {
		display: flex;
		gap: 0.5rem;
	}
	.baris-cari input {
		flex: 1;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.5rem;
		background-color: var(--sl-color-bg);
		color: var(--sl-color-white);
		font-size: var(--sl-text-base);
		padding: 0.625rem 0.875rem;
	}
	.baris-cari input:focus {
		border-color: var(--sl-color-accent);
		outline: none;
	}
	.baris-cari button {
		border: 1px solid var(--sl-color-accent);
		border-radius: 0.5rem;
		background-color: var(--sl-color-accent-low);
		color: var(--sl-color-white);
		font-weight: 600;
		padding-inline: 1.25rem;
		cursor: pointer;
	}
	.kontrol-filter {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		align-items: center;
		margin-top: 0.75rem;
	}
	.filter-modul {
		position: relative;
	}
	.filter-modul summary {
		cursor: pointer;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.375rem;
		padding: 0.375rem 0.75rem;
		font-size: var(--sl-text-sm);
		list-style: none;
		user-select: none;
	}
	.filter-modul summary::-webkit-details-marker {
		display: none;
	}
	.filter-modul[open] summary {
		border-color: var(--sl-color-accent);
	}
	.filter-modul fieldset {
		position: absolute;
		z-index: 10;
		inset-inline-start: 0;
		top: calc(100% + 0.25rem);
		max-height: 60vh;
		overflow-y: auto;
		min-width: 16rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.5rem;
		background-color: var(--sl-color-bg);
		margin: 0;
		padding: 0.5rem;
	}
	.cek-modul {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.25rem 0.375rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-white);
	}
	.filter-select {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.filter-select select {
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.375rem;
		background-color: var(--sl-color-bg);
		color: var(--sl-color-white);
		padding: 0.375rem 0.5rem;
		font-size: var(--sl-text-sm);
	}
	.jumlah-hasil {
		margin-top: 1.5rem;
		font-weight: 600;
	}
	.daftar-hasil {
		list-style: none;
		margin: 1rem 0 0;
		padding: 0;
	}
	.daftar-hasil :global(li) {
		padding-block: 0.75rem;
		border-top: 1px solid var(--sl-color-gray-6);
	}
	.daftar-hasil :global(.judul) {
		font-weight: 600;
		color: var(--sl-color-text-accent);
		font-size: var(--sl-text-lg);
	}
	.daftar-hasil :global(.meta-hasil) {
		display: block;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		margin-top: 0.125rem;
	}
	.daftar-hasil :global(.cuplikan) {
		margin: 0.25rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.daftar-hasil :global(mark) {
		background-color: transparent;
		color: var(--sl-color-text-accent);
		font-weight: 600;
	}
	.nav-halaman {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-top: 1.5rem;
	}
	.nav-halaman button {
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.375rem;
		background-color: var(--sl-color-bg);
		color: var(--sl-color-white);
		padding: 0.375rem 0.875rem;
		cursor: pointer;
	}
	.nav-halaman button:disabled {
		opacity: 0.5;
		cursor: default;
	}
	.tanpa-hasil {
		margin-top: 1.5rem;
	}
	.saran-istilah {
		display: flex;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
	}
	.saran-istilah :global(a) {
		display: inline-block;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 999px;
		padding: 0.25rem 0.75rem;
		font-size: var(--sl-text-sm);
	}
	.pesan-galat {
		margin-top: 1.5rem;
		color: var(--sl-color-gray-2);
	}
</style>
