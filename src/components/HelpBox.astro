---
import kontakResmi from '~/data/kontak-resmi.json';

const base = import.meta.env.BASE_URL;

function tautan(jenis: string, nilai: string): string {
	if (jenis === 'email') return `mailto:${nilai}`;
	if (jenis === 'telepon') return `tel:${nilai.replace(/[^\d+]/g, '')}`;
	return nilai;
}
---

<section class="kotak-bantuan">
	<h2>Butuh bantuan lebih lanjut?</h2>
	<ul>
		{
			kontakResmi.kontak.map((k) => (
				<li>
					<a href={tautan(k.jenis, k.nilai)}>{k.nama}</a>
				</li>
			))
		}
	</ul>
	<a class="tombol-hubungi" href={`${base}bantuan/`}>Hubungi kami</a>
</section>

<style>
	.kotak-bantuan h2 {
		margin: 0 0 1rem;
		font-size: var(--sl-text-xl);
	}
	.kotak-bantuan ul {
		list-style: none;
		margin: 0 0 1rem;
		padding: 0;
	}
	.kotak-bantuan li {
		padding-block: 0.25rem;
	}
	.kotak-bantuan li a {
		color: var(--sl-color-white);
	}
	.tombol-hubungi {
		display: inline-block;
		padding: 0.5rem 1.25rem;
		border: 1px solid var(--sl-color-accent);
		border-radius: 0.5rem;
		color: var(--sl-color-text-accent);
		font-weight: 600;
		text-decoration: none;
	}
	.tombol-hubungi:hover,
	.tombol-hubungi:focus-visible {
		background-color: var(--sl-color-accent-low);
	}
</style>
