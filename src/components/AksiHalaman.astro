---
import { Icon } from '@astrojs/starlight/components';
import { adalahEntriKonten } from '~/lib/artikel.ts';
import { LABEL_EDIT, LABEL_LAPOR, tautanKoreksi } from '~/lib/situs.ts';

interface Props {
	posisi: 'atas' | 'bawah';
}

const { posisi } = Astro.props;
const route = Astro.locals.starlightRoute;
const entry = route?.entry;
const editUrl = route?.editUrl;
const data = entry?.data;
const adalahArtikel = data !== undefined && data.jenis !== 'indeks';
const tampil =
	editUrl !== undefined &&
	entry !== undefined &&
	route.id !== '' &&
	adalahEntriKonten(entry) &&
	data?.template !== 'splash';
---

{
	tampil && (
		<p class="aksi-halaman print:hidden" data-posisi={posisi} data-pagefind-ignore>
			<a data-aksi="edit" href={editUrl.href}>
				<Icon name="pencil" size="1rem" />
				{LABEL_EDIT}
			</a>
			{adalahArtikel && (
				<a
					class="lapor-kesalahan"
					data-aksi="lapor"
					href={tautanKoreksi(
						data.title,
						new URL(Astro.url.pathname, Astro.site).href,
					)}
				>
					<Icon name="comment-alt" size="1rem" />
					{LABEL_LAPOR}
				</a>
			)}
		</p>
	)
}

<style>
	.aksi-halaman {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0.75rem 0 0;
	}
	.aksi-halaman[data-posisi='bawah'] {
		margin-top: 1.5rem;
	}
	.aksi-halaman a {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.375rem;
		background-color: var(--sl-color-bg);
		color: var(--sl-color-white);
		padding: 0.375rem 0.75rem;
		font-size: var(--sl-text-sm);
		line-height: 1.4;
		text-decoration: none;
	}
	.aksi-halaman a:hover,
	.aksi-halaman a:focus-visible {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-text-accent);
	}
	@media print {
		.aksi-halaman {
			display: none;
		}
	}
</style>
