---
import FooterBawaan from '@astrojs/starlight/components/Footer.astro';
import { Icon } from '@astrojs/starlight/components';
import { formatTanggal } from '~/lib/tanggal.ts';
import { adalahEntriKonten } from '~/lib/artikel.ts';

const { entry } = Astro.locals.starlightRoute;
const data = entry.data;
const adalahIndeks =
	!adalahEntriKonten(entry) || data.jenis === 'indeks' || data.template === 'splash';
const verifikasi =
	data.terakhir_diverifikasi instanceof Date ? data.terakhir_diverifikasi : undefined;
const url = Astro.url.pathname;
---

{
	!adalahIndeks && (
		<div class="meta-artikel">
			{verifikasi && (
				<p class="terakhir-diverifikasi">
					Terakhir diverifikasi:{' '}
					<time datetime={verifikasi.toISOString()}>{formatTanggal(verifikasi)}</time>
				</p>
			)}
			<sakti-feedback class="widget-feedback" data-url={url}>
				<p class="pertanyaan-feedback">Apakah artikel ini membantu?</p>
				<div class="tombol-feedback">
					<button type="button" data-nilai="ya">
						<Icon name="approve-check" size="1rem" /> Ya
					</button>
					<button type="button" data-nilai="tidak">
						<Icon name="close" size="1rem" /> Tidak
					</button>
				</div>
				<p class="terima-kasih" aria-live="polite" hidden>
					Terima kasih atas masukannya.
				</p>
			</sakti-feedback>
		</div>
	)
}

<FooterBawaan {...Astro.props} />

<script>
	class SaktiFeedback extends HTMLElement {
		connectedCallback() {
			const url = this.dataset.url ?? location.pathname;
			const kunci = `sakti:feedback:${url}`;
			const selesai = () => {
				this.querySelector('.pertanyaan-feedback')!.setAttribute('hidden', '');
				this.querySelector('.tombol-feedback')!.setAttribute('hidden', '');
				this.querySelector('.terima-kasih')!.removeAttribute('hidden');
			};
			try {
				if (sessionStorage.getItem(kunci)) selesai();
			} catch {
				/* sessionStorage tidak tersedia */
			}
			for (const tombol of this.querySelectorAll<HTMLButtonElement>('button[data-nilai]')) {
				tombol.addEventListener('click', () => {
					const nilai = tombol.dataset.nilai!;
					try {
						sessionStorage.setItem(kunci, nilai);
					} catch {
						/* abaikan */
					}
					document.dispatchEvent(
						new CustomEvent('sakti:feedback', { detail: { nilai, url } }),
					);
					selesai();
				});
			}
		}
	}
	customElements.define('sakti-feedback', SaktiFeedback);
</script>

<style>
	.meta-artikel {
		margin-top: 3rem;
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2rem;
		align-items: baseline;
		justify-content: space-between;
	}
	.terakhir-diverifikasi {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		margin: 0;
	}
	.widget-feedback {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.pertanyaan-feedback {
		margin: 0;
		font-size: var(--sl-text-sm);
		font-weight: 600;
	}
	.tombol-feedback {
		display: flex;
		gap: 0.5rem;
	}
	.tombol-feedback button {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.375rem;
		background-color: var(--sl-color-bg);
		color: var(--sl-color-white);
		padding: 0.375rem 0.75rem;
		font-size: var(--sl-text-sm);
		cursor: pointer;
	}
	.tombol-feedback button:hover,
	.tombol-feedback button:focus-visible {
		border-color: var(--sl-color-accent);
	}
	.terima-kasih {
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
</style>
