---
import { Badge } from '@astrojs/starlight/components';
import { muatKonfigurasi } from '~/lib/modul.ts';
import { labelJenis } from '~/lib/istilah.ts';
import { jalurHalaman } from '~/lib/jalur.ts';
import { adalahEntriKonten } from '~/lib/artikel.ts';
import { modulDanBreadcrumb } from '~/lib/cari/lite.ts';

const { entry } = Astro.locals.starlightRoute;
const data = entry.data;

const konfigurasi = muatKonfigurasi();
const { modul, breadcrumb } = modulDanBreadcrumb(String(entry.id ?? ''), data, konfigurasi);
const jenis = typeof data.jenis === 'string' ? data.jenis : undefined;
const peran: string[] = Array.isArray(data.peran) ? data.peran : [];
const kataKunci: string[] = Array.isArray(data.kata_kunci) ? data.kata_kunci : [];
const menuSakti = typeof data.menu_sakti === 'string' ? data.menu_sakti : undefined;
const status = typeof data.status === 'string' ? data.status : undefined;
const base = import.meta.env.BASE_URL;

const jalur = jalurHalaman({
	menuSakti,
	modulSlug: modul?.slug,
	entryId: String(entry.id ?? ''),
	konfigurasi,
	base,
});
const namaPeran = new Map(konfigurasi.peran.map((p) => [p.slug, p.nama]));
const tampilJalur = jalur.length > 0 && jenis !== undefined;
const adalahArtikel =
	adalahEntriKonten(entry) && jenis !== 'indeks' && data.template !== 'splash';
---

{
	tampilJalur && (
		<nav class="jalur-sakti" aria-label="Jalur menu SAKTI">
			<ol>
				{jalur.map((s, i) => (
					<li>
						{i > 0 && (
							<span class="pemisah-jalur" aria-hidden="true">
								›
							</span>
						)}
						{s.href ? <a href={s.href}>{s.label}</a> : <span>{s.label}</span>}
					</li>
				))}
			</ol>
		</nav>
	)
}
<h1 id="_top" data-pagefind-weight="10">{data.title}</h1>
{
	adalahArtikel ? (
		<p class="badge-artikel">
			{jenis && <Badge text={labelJenis(jenis)} variant="note" />}
			{peran.map((slug) => (
				<a class="badge-peran" href={`${base}peran/${slug}/`}>
					<Badge text={namaPeran.get(slug) ?? slug} variant="tip" />
				</a>
			))}
			{status === 'review' && <Badge text="Sedang ditinjau" variant="caution" />}
		</p>
	) : null
}
{
	modul && (
		<>
			<span class="sr-only" aria-hidden="true" data-pagefind-filter="modul">
				{modul.slug}
			</span>
			<span class="sr-only" aria-hidden="true" data-pagefind-meta="modul">
				{modul.nama}
			</span>
		</>
	)
}
{
	jenis && (
		<>
			<span class="sr-only" aria-hidden="true" data-pagefind-filter="jenis">
				{jenis}
			</span>
			<span class="sr-only" aria-hidden="true" data-pagefind-meta="jenis">
				{labelJenis(jenis)}
			</span>
		</>
	)
}
{
	peran.map((slug) => (
		<span class="sr-only" aria-hidden="true" data-pagefind-filter="peran">
			{slug}
		</span>
	))
}
{
	breadcrumb && (
		<span class="sr-only" aria-hidden="true" data-pagefind-meta="breadcrumb">
			{breadcrumb}
		</span>
	)
}
{
	kataKunci.length > 0 && (
		<span class="sr-only" aria-hidden="true" data-pagefind-weight="7">
			{kataKunci.join(', ')}
		</span>
	)
}

<style>
	@layer starlight.core {
		h1 {
			margin-top: 1rem;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}
		.jalur-sakti {
			margin-top: 1rem;
			font-size: var(--sl-text-sm);
		}
		.jalur-sakti ol {
			display: flex;
			flex-wrap: wrap;
			gap: 0.375rem;
			list-style: none;
			margin: 0;
			padding: 0;
		}
		.jalur-sakti li {
			display: flex;
			align-items: center;
			gap: 0.375rem;
			margin: 0;
		}
		.pemisah-jalur {
			color: var(--sl-color-gray-4);
		}
		.jalur-sakti a {
			color: var(--sl-color-text-accent);
		}
		.jalur-sakti span {
			color: var(--sl-color-gray-2);
		}
		.badge-artikel {
			display: flex;
			flex-wrap: wrap;
			gap: 0.375rem;
			margin-top: 0.5rem;
		}
		.badge-peran {
			text-decoration: none;
		}
	}
</style>
