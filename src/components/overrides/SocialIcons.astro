---
const base = import.meta.env.BASE_URL;

const tautan = [
	{ label: 'Modul', href: `${base}#modul` },
	{ label: 'Peran', href: `${base}peran/` },
	{ label: 'Bantuan', href: `${base}bantuan/` },
];
---

<nav class="nav-atas" aria-label="Navigasi utama">
	{tautan.map((t) => <a href={t.href}>{t.label}</a>)}
</nav>

<style>
	@layer starlight.core {
		.nav-atas {
			display: flex;
			gap: 0.25rem;
		}
		a {
			color: var(--sl-color-white);
			padding: 0.5em;
			margin: -0.5em;
			margin-inline: 0.25em;
			font-size: var(--sl-text-sm);
			font-weight: 500;
			text-decoration: none;
		}
		a:hover {
			color: var(--sl-color-text-accent);
		}
	}
</style>
