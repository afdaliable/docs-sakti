---
import { artikelTampil } from '~/lib/artikel.ts';
import { tanggalArtikel, formatTanggal } from '~/lib/tanggal.ts';
import { muatKonfigurasi } from '~/lib/modul.ts';

const konfigurasi = muatKonfigurasi();
const namaModul = new Map(konfigurasi.modul.map((m) => [m.slug, m.nama]));
const base = import.meta.env.BASE_URL;

const terbaru = (await artikelTampil())
	.map((a) => ({ artikel: a, tanggal: tanggalArtikel({ ...a.data, filePath: a.filePath }) }))
	.filter((a): a is { artikel: typeof a.artikel; tanggal: Date } => a.tanggal !== null)
	.sort((a, b) => b.tanggal.getTime() - a.tanggal.getTime())
	.slice(0, 6);
---

<section class="baru-diperbarui">
	<h2>Baru diperbarui</h2>
	{
		terbaru.length === 0 ? (
			<p class="kosong">Belum ada artikel. Panduan sedang dimigrasikan.</p>
		) : (
			<ul>
				{terbaru.map(({ artikel, tanggal }) => (
					<li>
						<a href={`${base}${artikel.id}/`}>{artikel.data.title}</a>
						<span class="meta-artikel">
							{artikel.data.modul ? namaModul.get(artikel.data.modul) : ''}
							{' · '}
							<time datetime={tanggal.toISOString()}>{formatTanggal(tanggal)}</time>
						</span>
					</li>
				))}
			</ul>
		)
	}
</section>

<style>
	.baru-diperbarui h2 {
		margin: 0 0 1rem;
		font-size: var(--sl-text-xl);
	}
	.baru-diperbarui ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.baru-diperbarui li {
		display: flex;
		flex-direction: column;
		padding-block: 0.375rem;
	}
	.baru-diperbarui li + li {
		border-top: 1px solid var(--sl-color-gray-6);
	}
	.baru-diperbarui a {
		color: var(--sl-color-white);
		font-weight: 500;
	}
	.meta-artikel {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.kosong {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
</style>
