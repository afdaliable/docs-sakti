---
import populer from '~/data/populer.json';

const base = import.meta.env.BASE_URL;
---

<p class="tautan-populer">
	<span class="label-populer">Populer:</span>
	{
		populer.map((t, i) => (
			<>
				{i > 0 && <span class="pemisah" aria-hidden="true">·</span>}
				<a href={t.href.startsWith('/') ? `${base}${t.href.slice(1)}` : t.href}>{t.label}</a>
			</>
		))
	}
</p>

<style>
	.tautan-populer {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		font-size: var(--sl-text-sm);
	}
	.label-populer {
		color: var(--sl-color-gray-3);
	}
	.tautan-populer a {
		color: var(--sl-color-text-accent);
	}
	.pemisah {
		color: var(--sl-color-gray-4);
	}
</style>
