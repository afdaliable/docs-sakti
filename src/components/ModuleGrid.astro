---
import { Icon } from '@astrojs/starlight/components';
import { muatKonfigurasi } from '~/lib/modul.ts';
import { hitungPerModul } from '~/lib/artikel.ts';

const konfigurasi = muatKonfigurasi();
const hitung = await hitungPerModul();
const base = import.meta.env.BASE_URL;
---

{
	konfigurasi.kelompok.map((kelompok) => (
		<section class="kelompok-modul">
			<h2>{kelompok.nama}</h2>
			<div class="petak-modul">
				{konfigurasi.modul
					.filter((m) => m.kelompok === kelompok.id)
					.map((m) => {
						const jumlah = hitung.get(m.slug) ?? 0;
						return (
							<a class="kartu-modul" href={`${base}${m.slug}/`}>
								<span class="ikon-modul" aria-hidden="true">
									<Icon name={m.ikon as never} size="1.5rem" />
								</span>
								<span class="nama-modul">{m.nama}</span>
								<span class="ringkasan-modul">{m.ringkasan}</span>
								<span class="jumlah-modul">
									{jumlah > 0 ? `${jumlah} artikel` : 'Segera hadir'}
								</span>
							</a>
						);
					})}
			</div>
		</section>
	))
}

<style>
	.kelompok-modul {
		margin-top: 2rem;
	}
	.kelompok-modul h2 {
		margin: 0 0 1rem;
		font-size: var(--sl-text-xl);
	}
	.petak-modul {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.75rem;
	}
	@media (min-width: 40rem) {
		.petak-modul {
			grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
		}
	}
	.kartu-modul {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background-color: color-mix(in srgb, var(--sl-color-accent-low) 25%, transparent);
		color: var(--sl-color-white);
		text-decoration: none;
	}
	.kartu-modul:hover,
	.kartu-modul:focus-visible {
		border-color: var(--sl-color-accent);
	}
	.ikon-modul {
		color: var(--sl-color-text-accent);
	}
	.nama-modul {
		font-weight: 600;
		font-size: var(--sl-text-base);
	}
	.ringkasan-modul {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.jumlah-modul {
		margin-top: auto;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
</style>
