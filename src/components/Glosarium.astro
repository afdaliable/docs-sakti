---
import sinonim from '~/data/sinonim.json';

const daftar = [...sinonim].sort((a, b) => a.istilah.localeCompare(b.istilah));
---

<dl>
	{
		daftar.map((entri) => (
			<>
				<dt id={entri.istilah.toLowerCase()}>
					<strong>{entri.istilah}</strong>
				</dt>
				<dd>
					{entri.perlu_verifikasi ? 'Kepanjangan sedang diverifikasi.' : entri.panjang}
				</dd>
			</>
		))
	}
</dl>
