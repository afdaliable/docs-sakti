---
interface Props {
	modul?: string;
	autofocus?: boolean;
}

const { modul, autofocus = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const inputId = `sakti-cari-${Math.random().toString(36).slice(2, 8)}`;
---

<sakti-cari
	class="sakti-cari"
	data-base={base}
	data-modul={modul}
	data-autofocus={autofocus ? '' : undefined}
>
	<form role="search" action={`${base}cari/`} method="get" class="form-cari">
		<label class="sr-only" for={inputId}>Cari panduan SAKTI</label>
		<div class="kotak-cari">
			<svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" class="ikon-cari">
				<path
					fill="currentColor"
					d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 4.99L20.49 19l-4.99-5Zm-6 0A4.5 4.5 0 1 1 14 9.5 4.5 4.5 0 0 1 9.5 14Z"
				></path>
			</svg>
			<input
				id={inputId}
				type="search"
				name="q"
				autocomplete="off"
				role="combobox"
				aria-autocomplete="list"
				aria-expanded="false"
				aria-controls={`${inputId}-panel`}
				aria-activedescendant=""
				placeholder='Cari panduan SAKTI, mis. "cara batal SPM"'
			/>
			{modul && <input type="hidden" name="modul" value={modul} />}
		</div>
		<div class="panel-cari" hidden>
			<ul id={`${inputId}-panel`} role="listbox" aria-label="Hasil pencarian"></ul>
			<p class="status-panel" data-status></p>
			<a class="semua-hasil" data-semua hidden></a>
		</div>
		<p class="sr-only" aria-live="polite" data-pengumuman></p>
	</form>
</sakti-cari>

<script>
	import { siapkanLevel1 } from '../lib/cari/klien';
	import { cariLevel1 } from '../lib/cari/level1';
	import type { DataHasil, HasilLevel1, Ketergantungan } from '../lib/cari/level1';

	const MAKS_HASIL = 6;
	const DEBOUNCE_MS = 150;

	function bisaDiketik(el: EventTarget | null): boolean {
		if (!(el instanceof HTMLElement)) return false;
		return (
			el.isContentEditable ||
			['INPUT', 'TEXTAREA', 'SELECT'].includes(el.tagName) ||
			el.getAttribute('role') === 'searchbox'
		);
	}

	class SaktiCari extends HTMLElement {
		input!: HTMLInputElement;
		panel!: HTMLElement;
		listbox!: HTMLUListElement;
		statusPanel!: HTMLElement;
		semua!: HTMLAnchorElement;
		pengumuman!: HTMLElement;
		dep: Ketergantungan | null = null;
		depGagal = false;
		timer: ReturnType<typeof setTimeout> | undefined;
		token = 0;
		aktif = -1;
		pemutus: AbortController | undefined;

		get modulFilter() {
			const modul = this.dataset.modul;
			return { modul: modul ? [modul] : undefined };
		}

		connectedCallback() {
			this.pemutus?.abort();
			const { signal } = (this.pemutus = new AbortController());
			this.input = this.querySelector('input[type="search"]')!;
			this.panel = this.querySelector('.panel-cari')!;
			this.listbox = this.querySelector('ul[role="listbox"]')!;
			this.statusPanel = this.querySelector('[data-status]')!;
			this.semua = this.querySelector('[data-semua]')!;
			this.pengumuman = this.querySelector('[data-pengumuman]')!;

			this.input.addEventListener('input', () => this.jadwalkanCari(), { signal });
			this.input.addEventListener('keydown', (e) => this.tombolInput(e), { signal });
			this.input.addEventListener(
				'blur',
				() => {
					setTimeout(() => {
						if (!this.contains(document.activeElement)) this.tutup();
					}, 120);
				},
				{ signal },
			);
			this.listbox.addEventListener('mousedown', (e) => e.preventDefault(), { signal });
			document.addEventListener('keydown', (e) => this.pintasan(e), { signal });

			if (
				this.dataset.autofocus !== undefined &&
				window.matchMedia('(min-width: 50rem) and (pointer: fine)').matches
			) {
				this.input.focus();
			}
		}

		disconnectedCallback() {
			this.pemutus?.abort();
			clearTimeout(this.timer);
			this.token++;
		}

		pintasan(e: KeyboardEvent) {
			if (e.defaultPrevented || bisaDiketik(e.target)) return;
			if (e.key === '/' || ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k')) {
				e.preventDefault();
				this.input.focus();
				this.input.select();
			}
		}

		tombolInput(e: KeyboardEvent) {
			const opsi = this.opsi();
			if (e.key === 'Escape') {
				this.tutup();
				return;
			}
			if (this.panel.hidden) return;
			if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
				e.preventDefault();
				if (opsi.length === 0) return;
				const arah = e.key === 'ArrowDown' ? 1 : -1;
				this.aktif = (this.aktif + arah + opsi.length) % opsi.length;
				this.tandaiAktif(opsi);
				return;
			}
			if (e.key === 'Enter' && this.aktif >= 0 && opsi[this.aktif]) {
				e.preventDefault();
				(opsi[this.aktif].querySelector('a') as HTMLAnchorElement | null)?.click();
			}
		}

		opsi(): HTMLLIElement[] {
			return [...this.listbox.querySelectorAll('li[role="option"]')];
		}

		tandaiAktif(opsi: HTMLLIElement[]) {
			opsi.forEach((li, i) => {
				li.toggleAttribute('data-aktif', i === this.aktif);
				li.setAttribute('aria-selected', String(i === this.aktif));
				if (i === this.aktif) li.scrollIntoView({ block: 'nearest' });
			});
			this.input.setAttribute(
				'aria-activedescendant',
				this.aktif >= 0 ? opsi[this.aktif].id : '',
			);
		}

		jadwalkanCari() {
			clearTimeout(this.timer);
			this.timer = setTimeout(() => this.cari(), DEBOUNCE_MS);
		}

		async muatIndeks(): Promise<Ketergantungan | null> {
			if (this.dep) return this.dep;
			if (this.depGagal) return null;
			try {
				this.dep = await siapkanLevel1();
				return this.dep;
			} catch {
				this.depGagal = true;
				return null;
			}
		}

		tampilStatus(pesan: string) {
			this.listbox.replaceChildren();
			this.semua.hidden = true;
			this.statusPanel.textContent = pesan;
			this.panel.hidden = false;
			this.input.setAttribute('aria-expanded', 'true');
			this.pengumuman.textContent = pesan;
		}

		tutup() {
			this.panel.hidden = true;
			this.input.setAttribute('aria-expanded', 'false');
			this.aktif = -1;
		}

		async cari() {
			const q = this.input.value.trim();
			if (q.length < 2) {
				this.tutup();
				return;
			}
			const token = ++this.token;
			const dep = await this.muatIndeks();
			if (token !== this.token) return;
			if (!dep) {
				this.tampilStatus('Pencarian tersedia setelah pnpm build. Jalankan pnpm preview.');
				return;
			}
			this.tampilStatus('Mencari…');
			let hasil: HasilLevel1;
			try {
				hasil = await cariLevel1(q, this.modulFilter, dep);
			} catch {
				if (token !== this.token) return;
				this.tampilStatus('Pencarian gagal dijalankan. Coba lagi.');
				return;
			}
			if (token !== this.token) return;
			const data = await Promise.all(hasil.butir.slice(0, MAKS_HASIL).map((b) => b.data()));
			if (token !== this.token) return;
			this.renderHasil(q, hasil, data);
		}

		renderHasil(q: string, hasil: HasilLevel1, data: DataHasil[]) {
			this.aktif = -1;
			this.statusPanel.textContent = '';
			const base = this.dataset.base ?? '/';
			const total = hasil.butir.length;
			const tanpaPersis = hasil.jumlahPagefind === 0 && total > 0;
			const adaMirip = total > hasil.jumlahPagefind;
			if (total === 0) {
				this.tampilStatus(`Tidak ada hasil untuk "${q}". Coba kata lain.`);
				return;
			}
			const frag = document.createDocumentFragment();
			for (const [i, r] of data.entries()) {
				const li = document.createElement('li');
				li.setAttribute('role', 'option');
				li.setAttribute('aria-selected', 'false');
				li.id = `${this.input.id}-opsi-${i}`;
				const a = document.createElement('a');
				a.href = r.url;
				const judul = document.createElement('span');
				judul.className = 'judul-hasil';
				judul.textContent = r.judul;
				a.append(judul);
				const baris = document.createElement('span');
				baris.className = 'meta-hasil';
				if (r.breadcrumb) {
					const bc = document.createElement('span');
					bc.className = 'breadcrumb-hasil';
					bc.textContent = r.breadcrumb;
					baris.append(bc);
				}
				if (r.jenis) {
					const label = document.createElement('span');
					label.className = 'jenis-hasil';
					label.textContent = r.jenis;
					baris.append(label);
				}
				a.append(baris);
				if (r.cuplikan) {
					const cuplikan = document.createElement('span');
					cuplikan.className = 'cuplikan-hasil';
					cuplikan.innerHTML = r.cuplikan;
					a.append(cuplikan);
				}
				li.append(a);
				frag.append(li);
			}
			if (total > MAKS_HASIL) {
				this.semua.href = `${base}cari/?q=${encodeURIComponent(q)}`;
				this.semua.textContent = `Lihat semua hasil (${total})`;
				this.semua.hidden = false;
			} else {
				this.semua.hidden = true;
			}
			this.listbox.replaceChildren(frag);
			if (tanpaPersis) {
				this.statusPanel.textContent = 'Tidak ada hasil persis. Menampilkan hasil yang mirip.';
				this.pengumuman.textContent = `Tidak ada hasil persis untuk "${q}". ${total} hasil yang mirip.`;
			} else if (adaMirip) {
				this.statusPanel.textContent = 'Menampilkan juga hasil yang mirip.';
				this.pengumuman.textContent = `${total} hasil untuk "${q}", termasuk hasil yang mirip.`;
			} else {
				this.pengumuman.textContent = `${total} hasil untuk "${q}".`;
			}
			this.panel.hidden = false;
			this.input.setAttribute('aria-expanded', 'true');
			this.input.setAttribute('aria-activedescendant', '');
		}
	}

	customElements.define('sakti-cari', SaktiCari);
</script>

<style>
	.sakti-cari {
		display: block;
		position: relative;
	}
	.form-cari {
		position: relative;
	}
	.kotak-cari {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.5rem;
		background-color: var(--sl-color-bg);
		padding-inline: 0.875rem;
	}
	.kotak-cari:focus-within {
		border-color: var(--sl-color-accent);
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 1px;
	}
	.ikon-cari {
		color: var(--sl-color-gray-3);
		flex-shrink: 0;
	}
	input[type='search'] {
		width: 100%;
		border: 0;
		background: transparent;
		color: var(--sl-color-white);
		font-size: var(--sl-text-lg);
		padding-block: 0.875rem;
	}
	input[type='search']:focus {
		outline: none;
	}
	input[type='search']::placeholder {
		color: var(--sl-color-gray-3);
		opacity: 1;
	}
	.panel-cari {
		position: absolute;
		inset-inline: 0;
		top: calc(100% + 0.375rem);
		z-index: 10;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.5rem;
		background-color: var(--sl-color-bg);
		box-shadow: var(--sl-shadow-md);
		max-height: min(26rem, 60vh);
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 0.375rem;
		scrollbar-width: thin;
		scrollbar-color: var(--sl-color-gray-4) transparent;
	}
	.panel-cari ul {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.panel-cari :global(li[role='option'] a) {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		border-radius: 0.375rem;
		padding: 0.625rem 0.75rem;
		color: var(--sl-color-white);
		text-decoration: none;
	}
	.panel-cari :global(li[role='option'] a:hover),
	.panel-cari :global(li[role='option'] a:focus-visible),
	.panel-cari :global(li[data-aktif] a) {
		background-color: var(--sl-color-gray-6);
	}
	.panel-cari :global(li[role='option'] a:focus-visible),
	.panel-cari :global(li[data-aktif] a) {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: -2px;
	}
	.panel-cari :global(.judul-hasil) {
		display: block;
		font-size: var(--sl-text-base);
		font-weight: 600;
		line-height: 1.35;
		overflow-wrap: anywhere;
	}
	.panel-cari :global(.meta-hasil) {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0.5rem;
		font-size: var(--sl-text-xs);
		line-height: 1.4;
		color: var(--sl-color-gray-2);
	}
	.panel-cari :global(.breadcrumb-hasil) {
		min-width: 0;
		overflow-wrap: anywhere;
	}
	.panel-cari :global(.jenis-hasil) {
		flex-shrink: 0;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 999px;
		padding: 0 0.5rem;
		font-weight: 600;
	}
	.panel-cari :global(.cuplikan-hasil) {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		overflow: hidden;
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
		overflow-wrap: anywhere;
	}
	.panel-cari :global(mark) {
		border-radius: 0.125rem;
		padding-inline: 0.125rem;
		background-color: var(--sl-color-accent-low);
		color: var(--sl-color-white);
		-webkit-box-decoration-break: clone;
		box-decoration-break: clone;
	}
	.status-panel {
		margin: 0;
		padding: 0.5rem 0.75rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.status-panel:empty {
		display: none;
	}
	.semua-hasil {
		display: block;
		margin-top: 0.125rem;
		border-radius: 0.375rem;
		padding: 0.625rem 0.75rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-text-accent);
		text-decoration: none;
	}
	.semua-hasil[hidden] {
		display: none;
	}
	.semua-hasil:hover,
	.semua-hasil:focus-visible {
		background-color: var(--sl-color-gray-6);
	}
	.semua-hasil:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: -2px;
	}
</style>
