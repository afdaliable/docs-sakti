{
  "name": "docs-sakti",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "build:github": "tsx scripts/build-github.ts",
    "build:pages": "if [ \"$(git rev-parse --is-shallow-repository)\" = \"true\" ]; then git fetch --unshallow; fi && pnpm build",
    "check:content": "tsx scripts/check-content.ts",
    "check:dist": "tsx scripts/check-dist.ts",
    "check:links": "astro build",
    "search:eval": "tsx scripts/search/eval.ts",
    "migrate:inventory": "tsx scripts/inventory/index.ts",
    "migrate:extract": "tsx scripts/extract/index.ts",
    "migrate:draft": "node scripts/belum-tersedia.mjs migrate:draft 4",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx tests/e2e/pencarian.e2e.ts && tsx tests/e2e/beranda.e2e.ts && tsx tests/e2e/navigasi.e2e.ts && tsx tests/e2e/kontribusi.e2e.ts && tsx tests/e2e/dropdown.e2e.ts",
    "scaffold:indeks": "tsx scripts/scaffold-indeks.ts"
  },
  "dependencies": {
    "@astrojs/starlight": "0.43.1",
    "astro": "7.4.12",
    "minisearch": "7.2.0",
    "sharp": "0.35.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/turndown": "5.0.5",
    "playwright": "1.65.1",
    "starlight-links-validator": "0.27.0",
    "tsx": "4.23.15",
    "turndown": "7.2.5",
    "turndown-plugin-gfm": "1.0.2"
  }
}
